# Build output — regenerate with `python package.py`
dist/

# Scratch PDF text extraction (copyrighted paper content, mostly binary junk)
_extracted.txt

# Local machine-specific Claude settings
.claude/settings.local.json

# Live Black Duck SCA connection config — holds instance URL + API token.
# Never commit real credentials; copy blackduck.local.example.json and fill in.
blackduck.local*.json
bd-credentials.local.json

# Live provisioning / recreation output (instance-derived, regenerable) and venvs.
live*/
.venv/

# Monitor-local: which data dir each project was last loaded from (absolute paths).
.monitor-loaded.json

# Service logs + pidfiles from infra/serve.ps1
logs/

# Local partial-mirror clones used by the 'check for updates' backfill
clones/

__pycache__/
*.pyc
